<mxGraphModel adaptiveColors="auto" page="1" pageWidth="1400" pageHeight="1100"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Agent 为什么重复调用工具？——调用中断与恢复风险" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1250" height="50" as="geometry"/></mxCell>
<mxCell id="send" value="Agent 发出工具请求" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="execute" value="工具接收并执行&lt;br&gt;外部操作可能继续" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=18;" vertex="1" parent="1"><mxGeometry x="380" y="130" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="effect" value="业务效果已发生&lt;br&gt;例如邮件已发出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=18;" vertex="1" parent="1"><mxGeometry x="720" y="130" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="saved" value="Agent 收到结果&lt;br&gt;并持久化成功记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1060" y="130" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="risk1" value="风险 A：发出后中断&lt;br&gt;进程被杀 / 用户停止&lt;br&gt;取消未确认生效" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="280" height="110" as="geometry"/></mxCell>
<mxCell id="risk2" value="风险 B：工具只完成部分步骤&lt;br&gt;例如文件已上传，通知未发送&lt;br&gt;已产生部分副作用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=17;" vertex="1" parent="1"><mxGeometry x="380" y="330" width="280" height="110" as="geometry"/></mxCell>
<mxCell id="risk3" value="风险 C：成功确认未持久化&lt;br&gt;响应丢失 / 等待超时&lt;br&gt;或收到后、保存前崩溃" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=17;" vertex="1" parent="1"><mxGeometry x="720" y="330" width="280" height="110" as="geometry"/></mxCell>
<mxCell id="unknown" value="恢复或错误处理时，缺少可靠完成证据&lt;br&gt;整体或部分操作的结果仍需确认" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=18;" vertex="1" parent="1"><mxGeometry x="380" y="530" width="620" height="80" as="geometry"/></mxCell>
<mxCell id="retry" value="错误处理：把缺少成功记录当作未执行&lt;br&gt;客户端 / 执行器 / 模型 / 恢复逻辑重新调用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=18;" vertex="1" parent="1"><mxGeometry x="380" y="690" width="620" height="80" as="geometry"/></mxCell>
<mxCell id="duplicate" value="工具未可靠识别同一次业务操作&lt;br&gt;已完成部分再次执行 → 重复订单 / 邮件 / 扣款" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=18;" vertex="1" parent="1"><mxGeometry x="380" y="850" width="620" height="80" as="geometry"/></mxCell>
<mxCell id="note" value="蓝色：正常调用　黄色：状态不确定的风险　红色：导致重复副作用的条件&lt;br&gt;虚线：风险分支，并非必然发生。停止 Agent ≠ 已取消外部操作；重复请求 ≠ 必然重复业务效果。" style="text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="1260" height="70" as="geometry"/></mxCell>
<mxCell id="e1" edge="1" source="send" target="execute" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" edge="1" source="execute" target="effect" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" edge="1" source="effect" target="saved" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" edge="1" source="send" target="risk1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#D6B656;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" edge="1" source="execute" target="risk2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#D6B656;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" edge="1" source="effect" target="risk3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#D6B656;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" edge="1" source="risk1" target="unknown" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" edge="1" source="risk2" target="unknown" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" edge="1" source="risk3" target="unknown" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" edge="1" source="unknown" target="retry" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e11" edge="1" source="retry" target="duplicate" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel>
